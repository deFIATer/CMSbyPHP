# =============================================================
# Modo CMS — do NOT commit runtime data or local configuration.
# Keep the .htaccess guards and the directory structure.
# =============================================================

# --- Database (created by install.php) ---
data/cms.sqlite
data/*.sqlite
data/*.sqlite3
data/*.db

# --- Runtime directories (keep only the .htaccess guards) ---
data/backups/*
!data/backups/.htaccess
data/cache/*
!data/cache/.htaccess
data/logs/*
!data/logs/.htaccess
data/other/*
!data/other/.htaccess
data/pages/*
!data/pages/.htaccess
data/sessions/*
!data/sessions/.htaccess

# --- Uploaded media (user content) ---
uploads/*
!uploads/.htaccess
!uploads/cache/
uploads/cache/*
!uploads/cache/.htaccess

# --- Local configuration (copy of cmsbyphpconfig.sample.php) ---
modoconfig.php
cmsbyphpconfig.php

# --- Protected files & packages ---
data/protected_files/*
!data/protected_files/.htaccess
*.zip
*.bak

# --- Editor / OS / logs ---
.DS_Store
Thumbs.db
*.log

ftp_config.json
deploy_ftp.py
deploy.sh
